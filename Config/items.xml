  <set xpath="/items/item[@name='backpackSmall' or @name='backpackMedium' or @name='backpackLarge']/effect_group/display_value[@name='dSlotCount']/@value">0</set>
  <set xpath="/items/item[@name='drugSteroids']/effect_group/display_value[@name='dCarryCapacity']/@value">960</set>
</configs>
